{
  "ReverseProxy": {
    "Routes": {
      "auth":             { "ClusterId": "user",         "Match": { "Path": "/api/v1/auth/{**rest}" } },
      "users":            { "ClusterId": "user",         "Match": { "Path": "/api/v1/users/{**rest}" } },
      "vehicles":         { "ClusterId": "vehicle",      "Match": { "Path": "/api/v1/vehicles/{**rest}" } },
      "parking-lots":     { "ClusterId": "parking",      "Match": { "Path": "/api/v1/parking-lots/{**rest}" } },
      "bookings":         { "ClusterId": "booking",      "Match": { "Path": "/api/v1/bookings/{**rest}" } },
      "pricing":          { "ClusterId": "payment",      "Match": { "Path": "/api/v1/pricing/{**rest}" } },
      "payments":         { "ClusterId": "payment",      "Match": { "Path": "/api/v1/payments/{**rest}" } },
      "notifications":    { "ClusterId": "notification", "Match": { "Path": "/api/v1/notifications/{**rest}" } },
      "parking-sessions": { "ClusterId": "gate",         "Match": { "Path": "/api/v1/parking-sessions/{**rest}" } },
      "admin":            { "ClusterId": "admin",        "Match": { "Path": "/api/v1/admin/{**rest}" } },
      "complaints":       { "ClusterId": "support",      "Match": { "Path": "/api/v1/complaints/{**rest}" } },
      "reviews":          { "ClusterId": "support",      "Match": { "Path": "/api/v1/reviews/{**rest}" } },
      "faqs":             { "ClusterId": "support",      "Match": { "Path": "/api/v1/faqs/{**rest}" } }
    },
    "Clusters": {
      "user":         { "Destinations": { "primary": { "Address": "http://localhost:5101/" } } },
      "vehicle":      { "Destinations": { "primary": { "Address": "http://localhost:5102/" } } },
      "parking":      { "Destinations": { "primary": { "Address": "http://localhost:5103/" } } },
      "booking":      { "Destinations": { "primary": { "Address": "http://localhost:5104/" } } },
      "payment":      { "Destinations": { "primary": { "Address": "http://localhost:5105/" } } },
      "notification": { "Destinations": { "primary": { "Address": "http://localhost:5106/" } } },
      "gate":         { "Destinations": { "primary": { "Address": "http://localhost:5107/" } } },
      "admin":        { "Destinations": { "primary": { "Address": "http://localhost:5108/" } } },
      "support":      { "Destinations": { "primary": { "Address": "http://localhost:5109/" } } }
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*"
}
