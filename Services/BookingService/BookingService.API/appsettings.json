{
  "ConnectionStrings": {
    "ServiceDb": "Host=localhost;Port=5432;Database=pm_booking;Username=postgres;Password=postgres"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true,
    "SeedDemoData": true
  },
  "Services": {
    "GatewayBaseUrl": "http://localhost:5000"
  },
  "SessionCompletion": {
    "IntervalSeconds": 60,
    "RemindAfterStartMinutes": 120,
    "AutoCompleteAfterEndHours": 12,
    "NoShowAfterEndHours": 6
  },
  "BookingAbuse": {
    "MaxBookingActionsPerHour": 10,
    "ActionWindowMinutes": 60,
    "NoShowRateThreshold": 0.5,
    "NoShowMinFinishedBookings": 5,
    "NoShowLookbackDays": 30
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:5000" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}