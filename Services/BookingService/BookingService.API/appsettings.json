{
  "ConnectionStrings": {
    "ServiceDb": "Host=localhost;Port=5432;Database=pm_booking;Username=postgres;Password=postgres"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true,
    "SeedDemoData": true
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:5000" ]
  },
  "EventBus": {
    "Enabled": false,
    "MaxAttempts": 10,
    "RabbitMq": {
      "HostName": "localhost", "Port": 5672, "VirtualHost": "parking",
      "UserName": "parking", "Password": "",
      "Exchange": "parking.events",
      "UseTls": false, "OperationTimeoutSeconds": 10
    },
    "Subscription": {
      "Queue": "booking.service",
      "RoutingKeys": [ "PaymentSucceeded", "PaymentFailed" ],
      "PrefetchCount": 10
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}