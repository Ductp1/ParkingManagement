{
  "ConnectionStrings": {
    "ServiceDb": "Host=localhost;Port=5432;Database=pm_notification;Username=postgres;Password=postgres"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true,
    "SeedDemoData": true
  },
  "UserService": {
    "BaseUrl": "http://localhost:5101"
  },
  "EventBus": {
    "Enabled": false,
    "MaxAttempts": 10,
    "RabbitMq": {
      "HostName": "localhost", "Port": 5672, "VirtualHost": "parking",
      "UserName": "parking", "Password": "",
      "Exchange": "parking.events",
      "UseTls": false, "OperationTimeoutSeconds": 10
    },
    "Subscription": {
      "Queue": "notification.service",
      "RoutingKeys": [
        "BookingCreated", "BookingConfirmed", "BookingCancelled", "BookingModified", "BookingPaymentCompleted",
        "LotDataMarkedStale", "LotDataRecovered", "LotEmergencyStopped"
      ],
      "PrefetchCount": 10
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:5000" ]
  },
  "SmtpConfiguration": {
    "Host": "localhost",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromEmail": "noreply@parkingmanagement.local",
    "FromName": "Parking Management",
    "EnableSsl": false,
    "UseMock": true,
    "TimeoutMs": 10000
  },
  "SmsConfiguration": {
    "Provider": "Mock",
    "UseMock": true,
    "MockFailFirstAttempts": 0,
    "MockAlwaysFail": false
  },
  "FcmConfiguration": {
    "ProjectId": "",
    "ServiceAccountKey": "",
    "UseMock": true,
    "TimeoutMs": 10000,
    "TopicPrefix": "parking_notifications"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
