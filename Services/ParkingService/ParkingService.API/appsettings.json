{
  "ConnectionStrings": {
    "ServiceDb": "Host=localhost;Port=5432;Database=pm_parking;Username=postgres;Password=postgres"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true,
    "SeedDemoData": true
  },
  "KybMisdeclaration": {
    "MinorCorrectionDays": 7
  },
  "Staleness": {
    "StaleAfterMinutes": 3,
    "PollSeconds": 30
  },
  "BookingService": {
    "BaseUrl": "http://localhost:5104/"
  },
  "EventBus": {
    "Enabled": false,
    "MaxAttempts": 10,
    "RabbitMq": {
      "HostName": "localhost", "Port": 5672, "VirtualHost": "parking",
      "UserName": "parking", "Password": "",
      "Exchange": "parking.events",
      "UseTls": false, "OperationTimeoutSeconds": 10
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:5000" ]
  },
  "LotHeartbeat": {
    "StaleAfterMinutes": 3,
    "PollSeconds": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
