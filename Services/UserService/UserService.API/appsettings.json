{
  "ConnectionStrings": {
    "ServiceDb": "Host=localhost;Port=5432;Database=pm_user;Username=postgres;Password=postgres"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true,
    "SeedDemoData": false
  },
  "EventBus": {
    "Enabled": true,
    "MaxAttempts": 10,
    "RabbitMq": {
      "HostName": "localhost", "Port": 5672, "VirtualHost": "parking",
      "UserName": "parking", "Password": "", "Exchange": "parking.events",
      "UseTls": false, "OperationTimeoutSeconds": 10
    }
  },
  "Otp": { "DeliveryUrl": "" },
  "Security": { "AvatarPath": "App_Data/avatars" },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:5000" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Captcha": { "Enabled": true, "SecretKey": "", "AllowedHostnames": [ "localhost" ], "ExpectedAction": "login", "TimeoutSeconds": 5 },
  "AllowedHosts": "*"
}
